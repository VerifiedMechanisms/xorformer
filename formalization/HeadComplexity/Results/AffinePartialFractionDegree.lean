import Mathlib.Tactic

set_option linter.style.header false

namespace HeadComplexity

/-- Membership in the affine ideal generated by two parallel denominator
forms does not imply a decomposition with affine coefficient polynomials.
This is a polynomial identity obstruction, not a Boolean sign obstruction. -/
theorem parallel_denominators_no_affine_coefficients
    (c a₀ a₁ a₂ b₀ b₁ b₂ : ℝ) :
    ¬ (∀ x y : ℝ, x * y =
      c * (1 + x + y) * (2 + x + y) +
      (a₀ + a₁ * x + a₂ * y) * (2 + x + y) +
      (b₀ + b₁ * x + b₂ * y) * (1 + x + y)) := by
  intro h
  have h₀ := h 0 0
  have h₁ := h 1 (-1)
  have h₂ := h (-1) 1
  norm_num at h₀ h₁ h₂
  linarith

/-- The same numerator does have an unrestricted polynomial-coefficient
decomposition. The coefficients here are quadratic, not affine. -/
theorem parallel_denominators_quadratic_coefficients (x y : ℝ) :
    x * y = (x * y) * (2 + x + y) - (x * y) * (1 + x + y) := by
  ring

end HeadComplexity
