theorem velocities_positive : ∀ h i, 0 < velocity h i := by decide +kernel
theorem on_ellipse : ∀ h, (velocity h 0 - 2)^2 + (velocity h 0 - 2)*(velocity h 1 - 2) + (velocity h 1 - 2)^2 = 1 := by decide +kernel
theorem residues_nonzero : ∀ h, residue h ≠ 0 := by decide +kernel
theorem residues_distinct : Function.Injective residue := by decide +kernel
theorem projections_distinct : ∀ x, x ≠ 0 → Function.Injective (fun h => projection h x) := by decide +kernel
theorem moments_zero : ∀ x (j : Fin 4), moment x j.val = 0 := by decide +kernel
theorem fourth_moments : (fun x => moment x 4) = ![0, (90613464360 / 1405678729), (15464511960 / 1405678729), (-106077976320 / 1405678729)] := by decide +kernel
