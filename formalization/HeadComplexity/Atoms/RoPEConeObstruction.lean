import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Data.Real.Basic

set_option linter.style.header false

/-!
# A closed cone obstruction for denominator row spaces

A row space generated by zero-sum rows cannot contain a vector whose coordinate
sum is one. This is the final algebraic contradiction in the replicated-grid
argument; this module alone does not prove a head-count separation.
-/

namespace HeadComplexity
namespace RoPECone

open scoped BigOperators

variable {ι κ : Type*} [Fintype ι]

/-- The linear functional that sums the coordinates. -/
def coordinateSum : (ι → ℝ) →ₗ[ℝ] ℝ where
  toFun v := ∑ i, v i
  map_add' v w := Finset.sum_add_distrib
  map_smul' a v := by simp [Finset.mul_sum]

/-- Zero-sum generators have an entirely zero-sum linear span. -/
theorem span_le_coordinateSum_ker (r : κ → ι → ℝ)
    (hr : ∀ k, ∑ i, r k i = 0) :
    Submodule.span ℝ (Set.range r) ≤ LinearMap.ker coordinateSum := by
  apply Submodule.span_le.mpr
  rintro _ ⟨k, rfl⟩
  exact hr k

/-- A simplex-normalized vector cannot enter a zero-sum denominator row space.
The coordinate nonnegativity used to obtain compactness is not needed here. -/
theorem normalized_not_mem_zeroSum_span (r : κ → ι → ℝ)
    (hr : ∀ k, ∑ i, r k i = 0) (v : ι → ℝ) (hv : ∑ i, v i = 1) :
    v ∉ Submodule.span ℝ (Set.range r) := by
  intro hm
  have hz : ∑ i, v i = 0 := span_le_coordinateSum_ker r hr hm
  exact zero_ne_one (hz.symm.trans hv)

/-- The same obstruction when the limiting vector is specified by coefficients. -/
theorem normalized_not_row_combination [Fintype κ] (r : κ → ι → ℝ)
    (hr : ∀ k, ∑ i, r k i = 0) (a : κ → ℝ) (v : ι → ℝ)
    (hv : ∑ i, v i = 1) :
    ¬ (∀ i, v i = ∑ k, a k * r k i) := by
  intro he
  have hz : ∑ i, v i = 0 := by
    simp_rw [he]
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum, hr, mul_zero]
    exact Finset.sum_const_zero
  exact zero_ne_one (hz.symm.trans hv)

end RoPECone
end HeadComplexity
