import Mathlib.RingTheory.MvPolynomial.Groebner
import Mathlib.RingTheory.MvPolynomial.MonomialOrder.DegLex
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix
import Mathlib.LinearAlgebra.Basis.VectorSpace

set_option linter.style.header false

/-!
# A root bound for polynomial systems with diagonal leading terms

For a system `X i ^ d - p i`, with every `p i` of total degree less than `d`,
multivariate division leaves a remainder of degree less than `d` in every
variable. The coordinate algebra consequently has dimension at most `d ^ n`.
Distinct roots give distinct algebra homomorphisms from this algebra.

This is an algebraic ingredient for a perturbation proof of root bounds. It
does not assume or assert a sign-pattern counting theorem.
-/

namespace HeadComplexity.PolynomialRootCount

open MvPolynomial MonomialOrder
open scoped MonomialOrder

variable {K : Type*} [Field K] {n d : ℕ}

/-- The polynomial system with prescribed diagonal highest-degree terms. -/
noncomputable def diagonalSystem (p : Fin n → MvPolynomial (Fin n) K) (d : ℕ)
    (i : Fin n) : MvPolynomial (Fin n) K := X i ^ d - p i

private theorem lower_degree_lt_power (p : MvPolynomial (Fin n) K)
    (hp : p.totalDegree < d) (i : Fin n) :
    degLex.degree p ≺[degLex] degLex.degree (X i ^ d : MvPolynomial (Fin n) K) := by
  apply lt_of_not_ge
  intro h
  have ht := degLex_totalDegree_monotone h
  simp only [totalDegree_X_pow] at ht
  omega

theorem diagonalSystem_degree (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (i : Fin n) :
    degLex.degree (diagonalSystem p d i) = Finsupp.single i d := by
  classical
  rw [diagonalSystem, degLex.degree_sub_of_lt (lower_degree_lt_power _ (hp i) i)]
  rw [X_pow_eq_monomial, MonomialOrder.degree_monomial]
  simp

theorem diagonalSystem_monic (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (i : Fin n) :
    degLex.Monic (diagonalSystem p d i) := by
  unfold MonomialOrder.Monic diagonalSystem
  rw [degLex.leadingCoeff_sub_of_lt (lower_degree_lt_power _ (hp i) i)]
  simp [X_pow_eq_monomial]

/-- Every polynomial has a coordinatewise bounded remainder modulo the system. -/
theorem diagonalSystem_remainder (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (hd : 0 < d)
    (f : MvPolynomial (Fin n) K) :
    ∃ r : restrictDegree (Fin n) K (d - 1),
      f - r.1 ∈ Ideal.span (Set.range (diagonalSystem p d)) := by
  classical
  obtain ⟨g, r, hfr, _, hr⟩ := degLex.div
    (b := diagonalSystem p d)
    (fun i ↦ by rw [(diagonalSystem_monic p hp i).leadingCoeff_eq_one]; exact isUnit_one) f
  have hmem : r ∈ restrictDegree (Fin n) K (d - 1) := by
    rw [mem_restrictDegree]
    intro s hs i
    have hi := hr s hs i
    rw [diagonalSystem_degree p hp i, Finsupp.single_le_iff] at hi
    omega
  refine ⟨⟨r, hmem⟩, ?_⟩
  rw [hfr, add_sub_cancel_right, Finsupp.linearCombination_apply]
  exact Submodule.sum_mem _ fun i _ ↦
    (Ideal.span _).smul_mem _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The ideal generated by the diagonal system. -/
noncomputable def diagonalIdeal (p : Fin n → MvPolynomial (Fin n) K) (d : ℕ) :
    Ideal (MvPolynomial (Fin n) K) := Ideal.span (Set.range (diagonalSystem p d))

private theorem diagonal_quotient_surjective (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (hd : 0 < d) :
    Function.Surjective
      ((Ideal.Quotient.mkₐ K (diagonalIdeal p d)).toLinearMap.comp
        (restrictDegree (Fin n) K (d - 1)).subtype) := by
  intro z
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mkₐ_surjective K (diagonalIdeal p d) z
  obtain ⟨r, hr⟩ := diagonalSystem_remainder p hp hd f
  refine ⟨r, ?_⟩
  change Ideal.Quotient.mk _ r.1 = Ideal.Quotient.mk _ f
  exact ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr hr).symm

theorem diagonalIdeal_quotient_finite (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (hd : 0 < d) :
    Module.Finite K (MvPolynomial (Fin n) K ⧸ diagonalIdeal p d) :=
  Module.Finite.of_surjective _ (diagonal_quotient_surjective p hp hd)

private noncomputable def exponentBoxEquiv (n d : ℕ) :
    {s : Fin n →₀ ℕ // ∀ i, s i ≤ d} ≃ (Fin n → Fin (d + 1)) where
  toFun s i := ⟨s.1 i, by have := s.2 i; omega⟩
  invFun e := ⟨Finsupp.equivFunOnFinite.symm (fun i ↦ (e i).val), by
    intro i
    simpa using (e i).isLt⟩
  left_inv s := by apply Subtype.ext; ext i; simp
  right_inv e := by funext i; apply Fin.ext; simp

private theorem finrank_degree_box (d : ℕ) :
    Module.finrank K (restrictDegree (Fin n) K d) = (d + 1) ^ n := by
  classical
  let S : Set (Fin n →₀ ℕ) := {s | ∀ i, s i ≤ d}
  let e : S ≃ (Fin n → Fin (d + 1)) := exponentBoxEquiv n d
  let : Fintype S := Fintype.ofEquiv (Fin n → Fin (d + 1)) e.symm
  change Module.finrank K (restrictSupport K S) = _
  rw [Module.finrank_eq_card_basis (basisRestrictSupport K S), Fintype.card_congr e]
  simp

/-- The coordinate algebra has dimension at most the product of the diagonal degrees. -/
theorem diagonalIdeal_finrank_le (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (hd : 0 < d) :
    Module.finrank K (MvPolynomial (Fin n) K ⧸ diagonalIdeal p d) ≤ d ^ n := by
  have h := LinearMap.finrank_le_finrank_of_surjective
    (diagonal_quotient_surjective p hp hd)
  rw [finrank_degree_box, Nat.sub_add_cancel hd] at h
  exact h

/-- A root of the diagonal system, with its equations retained. -/
def DiagonalRoot (p : Fin n → MvPolynomial (Fin n) K) (d : ℕ) :=
  {x : Fin n → K // ∀ i, eval x (diagonalSystem p d i) = 0}

private noncomputable def rootHom (p : Fin n → MvPolynomial (Fin n) K)
    (d : ℕ) (x : DiagonalRoot p d) :
    (MvPolynomial (Fin n) K ⧸ diagonalIdeal p d) →ₐ[K] K :=
  Ideal.Quotient.liftₐ _ (aeval x.1) (by
    have hker : diagonalIdeal p d ≤ RingHom.ker (aeval x.1).toRingHom := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      exact x.2 i
    exact fun _ h ↦ hker h)

private theorem rootHom_injective (p : Fin n → MvPolynomial (Fin n) K) (d : ℕ) :
    Function.Injective (rootHom p d) := by
  intro x y h
  apply Subtype.ext
  funext i
  have hi := DFunLike.congr_fun h (Ideal.Quotient.mk (diagonalIdeal p d) (X i))
  change aeval x.1 (X i) = aeval y.1 (X i) at hi
  simpa using hi

/-- The root set of a diagonal-leading-term system is finite. -/
theorem diagonalRoot_finite (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (hd : 0 < d) :
    Finite (DiagonalRoot p d) := by
  let := diagonalIdeal_quotient_finite p hp hd
  exact Finite.of_injective _ (rootHom_injective p d)

/-- A fully algebraic root bound, valid over every field. -/
theorem diagonalRoot_card_le (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (hd : 0 < d) :
    Nat.card (DiagonalRoot p d) ≤ d ^ n := by
  let := diagonalIdeal_quotient_finite p hp hd
  exact (Nat.card_le_card_of_injective _ (rootHom_injective p d)).trans
    ((card_algHom_le_finrank K _ K).trans (diagonalIdeal_finrank_le p hp hd))

/-- A nonzero diagonal perturbation has at most `d ^ n` roots. -/
theorem perturbed_roots_card_le {ι : Type*} [Fintype ι]
    (p : Fin n → MvPolynomial (Fin n) K)
    (hp : ∀ i, (p i).totalDegree < d) (hd : 0 < d)
    (ε : K) (hε : ε ≠ 0) (x : ι → Fin n → K)
    (hx : Function.Injective x)
    (hroot : ∀ a i, eval (x a) (p i) + ε * x a i ^ d = 0) :
    Fintype.card ι ≤ d ^ n := by
  classical
  let q : Fin n → MvPolynomial (Fin n) K := fun i ↦ C (-ε⁻¹) * p i
  have hq (i : Fin n) : (q i).totalDegree < d := by
    exact (totalDegree_mul _ _).trans_lt (by simpa using hp i)
  let f : ι → DiagonalRoot q d := fun a ↦ ⟨x a, fun i ↦ by
    have hr := hroot a i
    simp only [diagonalSystem, q, map_sub, map_pow, eval_X, map_mul, eval_C]
    have he := congrArg (fun z ↦ ε⁻¹ * z) hr
    simpa [mul_add, ← mul_assoc, hε, sub_neg_eq_add, add_comm] using he⟩
  have hf : Function.Injective f := fun a b h ↦ hx (congrArg Subtype.val h)
  let := diagonalRoot_finite q hq hd
  have hcard := (Nat.card_le_card_of_injective f hf).trans (diagonalRoot_card_le q hq hd)
  simpa using hcard

end HeadComplexity.PolynomialRootCount
